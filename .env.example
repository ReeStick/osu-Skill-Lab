# Public development-only credentials. Replace for any shared deployment.
POSTGRES_USER=osu_lab
POSTGRES_PASSWORD=osu_lab_local
POSTGRES_DB=osu_skill_lab
POSTGRES_PORT=5432
API_PORT=8000

OSU_LAB_ENVIRONMENT=local
OSU_LAB_DATABASE_URL=postgresql+asyncpg://osu_lab:osu_lab_local@localhost:5432/osu_skill_lab
OSU_LAB_DATABASE_TIMEOUT_SECONDS=3

# Optional: OAuth application from https://osu.ppy.sh/home/account/edit#oauth
# Configure both locally; never commit real credentials. Tokens stay in RAM.
OSU_LAB_OSU_CLIENT_ID=
OSU_LAB_OSU_CLIENT_SECRET=
OSU_LAB_OSU_TIMEOUT_SECONDS=10
OSU_LAB_OSU_CACHE_TTL_SECONDS=3600
OSU_LAB_MIRROR_TIMEOUT_SECONDS=20
OSU_LAB_MIRROR_CACHE_TTL_SECONDS=600

# Tests read this from the process environment, not from .env.
# Create a separate database first; see README.
# OSU_LAB_TEST_DATABASE_URL=postgresql+asyncpg://osu_lab:osu_lab_local@localhost:5432/osu_skill_lab_test
